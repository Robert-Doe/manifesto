{
  "manifest_version": 3,
  "name": "NeuralTab",
  "version": "0.5.0",
  "description": "AI browser assistant — Module 05: Service Worker Internals & Keepalive Patterns",

  "action": {
    "default_popup": "popup.html",
    "default_title": "NeuralTab",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "options_page": "options.html",

  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab"
  ],

  "optional_permissions": [
    "tabs",
    "bookmarks",
    "history",
    "notifications"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "storage_manager.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["assets/inject.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
